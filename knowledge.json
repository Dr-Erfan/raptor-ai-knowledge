        add(f"جمع {i} و {j} چند است؟", str(i+j), "ریاضی")

# تفریق
for i in range(10, 51):
    for j in range(1, 11):
        if i-j >= 0:
            add(f"{i} منهای {j} چند است؟", str(i-j), "ریاضی")

# تقسیم
for i in range(2, 51):
    for j in range(2, 11):
        if i % j == 0:
            add(f"{i} تقسیم بر {j} چند است؟", str(i//j), "ریاضی")

