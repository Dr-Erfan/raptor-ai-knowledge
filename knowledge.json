<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>RAPTOR AI</title>

<style>
*{ box-sizing:border-box; margin:0; padding:0; }

body{
    font-family:Tahoma,Arial,sans-serif;
    background:#fff;
    color:#333;
    min-height:100vh;
    overflow-x:hidden;
}

/* =========================
   منوی سرایدار
========================= */

.topbar{
    width:100%;
    background:#fff;
    border-bottom:1px solid #f0f0f0;
    padding:14px 24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    position:sticky;
    top:0;
    z-index:100;
}

.topbar-brand{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:17px;
    font-weight:bold;
    color:#555;
}

.topbar-logo{
    width:38px;
    height:38px;
    border-radius:10px;
    background:#f5f5f5;
    border:1px solid #e8e8e8;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
}

.topbar-logo img{
    width:100%;
    height:100%;
    object-fit:contain;
    display:block;
}

.login-btn{
    padding:9px 26px;
    border-radius:11px;
    background:#fff;
    border:1px solid #ddd;
    color:#555;
    font-family:inherit;
    font-size:14px;
    font-weight:bold;
    cursor:pointer;
    transition:.25s;
    text-decoration:none;
    display:inline-block;
}

.login-btn:hover{
    background:#f7f7f7;
    border-color:#ccc;
    color:#333;
}

/* =========================
   هدر متن سفید با سایه
========================= */

.hero{
    width:100%;
    background:#fff;
    padding:100px 24px 120px;
    text-align:center;
}

.hero-inner{
    max-width:840px;
    margin:auto;
}

.hero-title{
    font-size:42px;
    font-weight:bold;
    line-height:1.7;
    margin-bottom:24px;
    color:#555;
    text-shadow:
        0 2px 0 #fff,
        0 6px 18px rgba(0,0,0,.10),
        0 12px 32px rgba(0,0,0,.06);
}

.hero-sub{
    font-size:17px;
    color:#b0b0b0;
    line-height:1.9;
}

/* =========================
   کارت‌های پفکی ابری
========================= */

.cards{
    max-width:1080px;
    margin:-60px auto 0;
    padding:0 20px 70px;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:28px;
    position:relative;
    z-index:5;
}

.card{
    background:#fff;
    border:1px solid #f2f2f2;
    border-radius:34px;
    padding:38px 30px;
    box-shadow:
        0 24px 50px rgba(0,0,0,.07),
        0 10px 22px rgba(0,0,0,.04);
    transition:.35s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:
        0 32px 60px rgba(0,0,0,.10),
        0 14px 28px rgba(0,0,0,.06);
}

.card-icon{
    width:56px;
    height:56px;
    border-radius:18px;
    background:#f7f7f7;
    border:1px solid #eee;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:22px;
}

.card-icon svg{
    width:28px;
    height:28px;
    stroke:#888;
    stroke-width:1.8;
    stroke-linecap:round;
    stroke-linejoin:round;
    fill:none;
}

.card h3{
    font-size:20px;
    color:#555;
    margin-bottom:14px;
    font-weight:bold;
}

.card p{
    font-size:14.5px;
    line-height:2;
    color:#999;
}

/* =========================
   فوتر
========================= */

.footer{
    text-align:center;
    padding:45px 20px 55px;
    border-top:1px solid #f2f2f2;
    background:#fff;
}

.footer-brand{
    font-size:16px;
    color:#666;
    font-weight:bold;
    margin-bottom:10px;
}

.footer-sub{
    font-size:13px;
    color:#b5b5b5;
    line-height:1.9;
}

/* =========================
   چت‌باکس پایین صفحه
========================= */

.chat-toggle{
    position:fixed;
    bottom:24px;
    left:24px;
    width:56px;
    height:56px;
    border-radius:50%;
    background:#fff;
    border:1px solid #ddd;
    box-shadow:0 12px 28px rgba(0,0,0,.12);
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:200;
    transition:.25s;
}

.chat-toggle:hover{
    transform:scale(1.06);
}

.chat-toggle svg{
    width:26px;
    height:26px;
    stroke:#666;
    stroke-width:1.8;
    fill:none;
    stroke-linecap:round;
    stroke-linejoin:round;
}

.chat-panel{
    position:fixed;
    bottom:96px;
    left:24px;
    width:360px;
    max-width:calc(100vw - 48px);
    height:480px;
    max-height:calc(100vh - 140px);
    background:#fff;
    border:1px solid #eee;
    border-radius:22px;
    box-shadow:0 28px 60px rgba(0,0,0,.15);
    display:none;
    flex-direction:column;
    overflow:hidden;
    z-index:200;
}

.chat-panel.open{ display:flex; }

.chat-head{
    padding:14px 18px;
    border-bottom:1px solid #f2f2f2;
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-size:14px;
    font-weight:bold;
    color:#555;
}

.chat-head span{ color:#999; font-weight:normal; font-size:12px; }

.chat-body{
    flex:1;
    overflow-y:auto;
    padding:16px;
    display:flex;
    flex-direction:column;
    gap:12px;
}

.msg{
    max-width:85%;
    padding:10px 14px;
    border-radius:14px;
    font-size:14px;
    line-height:1.9;
    white-space:pre-wrap;
}

.msg.user{
    align-self:flex-start;
    background:#f4f4f4;
    color:#333;
}

.msg.bot{
    align-self:flex-end;
    background:#fff;
    border:1px solid #eee;
    color:#444;
}

.chat-input{
    display:flex;
    border-top:1px solid #f2f2f2;
    padding:8px;
    gap:8px;
}

.chat-input textarea{
    flex:1;
    border:none;
    outline:none;
    resize:none;
    font-family:inherit;
    font-size:14px;
    padding:8px;
    min-height:40px;
    max-height:90px;
    direction:rtl;
    background:#fff;
}

.chat-send{
    width:40px;
    height:40px;
    border-radius:11px;
    border:1px solid #ddd;
    background:#fff;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
}

.chat-send:disabled{ opacity:.4; }

.chat-send svg{
    width:18px;
    height:18px;
    stroke:#555;
    stroke-width:2;
    fill:none;
    stroke-linecap:round;
    stroke-linejoin:round;
}

/* =========================
   موبایل
========================= */

@media(max-width:600px){

    .topbar{ padding:12px 16px; }
    .topbar-brand{ font-size:15px; }
    .login-btn{ padding:8px 20px; font-size:13px; }

    .hero{ padding:65px 18px 95px; }
    .hero-title{ font-size:27px; line-height:1.8; }
    .hero-sub{ font-size:14.5px; }

    .cards{ margin-top:-55px; gap:20px; }
    .card{ padding:30px 24px; border-radius:28px; }
    .card h3{ font-size:17.5px; }
    .card p{ font-size:13.5px; }

    .chat-panel{ left:12px; right:12px; width:auto; }
}
</style>
</head>

<body>

<!-- منوی سرایدار -->
<header class="topbar">
    <div class="topbar-brand">
        <div class="topbar-logo">
            <img
                src="https://s1.7upload.com/202609/file_00000000bd28821089d2ceba3cd30b0a-46u5mxz.png"
                alt="RAPTOR AI"
            >
        </div>
        <span>RAPTOR AI</span>
    </div>

    <a href="#" class="login-btn">ورود</a>
</header>


<!-- هدر متن سفید با سایه -->
<section class="hero">
    <div class="hero-inner">
        <h1 class="hero-title">
            هوش مصنوعی Raptor در خدمت شماست
        </h1>
        <p class="hero-sub">
            مدل Raptor AI 1.0 mini را همین الان امتحان کنید
        </p>
    </div>
</section>


<!-- کارت‌های ابری -->
<section class="cards">

    <div class="card">
        <div class="card-icon">
            <svg viewBox="0 0 24 24">
                <path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>
            </svg>
        </div>
        <h3>محدود ولی قوی</h3>
        <p>اولین نسخه Raptor AI با قابلیت کم ولی با اهداف بزرگ ایجاد شده!</p>
    </div>

    <div class="card">
        <div class="card-icon">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="5"/>
                <circle cx="12" cy="12" r="1.5"/>
            </svg>
        </div>
        <h3>چرا رپتور؟</h3>
        <p>رپتور هوش مصنوعی رایگان و مفید برای کاربران برای سوالات ساده است.</p>
    </div>

    <div class="card">
        <div class="card-icon">
            <svg viewBox="0 0 24 24">
                <path d="M12 2c3 3 5 7 5 11l-2 3h-6l-2-3c0-4 2-8 5-11z"/>
                <circle cx="12" cy="10" r="1.8"/>
                <path d="M9 19l-1 3 3-1"/>
                <path d="M15 19l1 3-3-1"/>
            </svg>
        </div>
        <h3>رپتور سریع و در دسترس و دائمی</h3>
        <p>رپتور نسخه سبک و کاربردی برای اکثر کاربران برای جست‌وجوی سوالات روزانه خود در دسترس راه‌اندازی شد.</p>
    </div>

</section>


<!-- فوتر -->
<footer class="footer">
    <div class="footer-brand">Raptor AI | ©2026</div>
    <div class="footer-sub">Raptor AI Free All Version</div>
</footer>


<!-- دکمه شناور چت -->
<button class="chat-toggle" id="chatToggle" aria-label="چت">
    <svg viewBox="0 0 24 24">
        <path d="M21 12a8 8 0 1 1-3.2-6.4"/>
        <path d="M3 21l3-3"/>
        <path d="M12 12l9 9"/>
    </svg>
</button>


<!-- پنل چت -->
<div class="chat-panel" id="chatPanel">

    <div class="chat-head">
        <div>RAPTOR AI</div>
        <span id="statusText">در حال اتصال...</span>
    </div>

    <div class="chat-body" id="chatBody">
        <div class="msg bot">سلام! من Raptor AI هستم. چه سوالی داری؟</div>
    </div>

    <div class="chat-input">
        <textarea id="userInput" rows="1" placeholder="سوالت را بنویس..."></textarea>
        <button class="chat-send" id="sendBtn" disabled>
            <svg viewBox="0 0 24 24">
                <path d="M22 2L11 13"/>
                <path d="M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
        </button>
    </div>

</div>


<script>
/* =========================================================
   پایگاه دانش Raptor AI
========================================================= */

const KNOWLEDGE_URL =
"https://raw.githubusercontent.com/Dr-Erfan/raptor-ai-knowledge/refs/heads/main/knowledge.json";

let knowledgeBase = [];
let dbReady = false;

const statusText = document.getElementById("statusText");
const sendBtn = document.getElementById("sendBtn");
const userInput = document.getElementById("userInput");
const chatBody = document.getElementById("chatBody");
const chatPanel = document.getElementById("chatPanel");
const chatToggle = document.getElementById("chatToggle");


/* =========================================================
   نرمال‌سازی متن فارسی
========================================================= */

function normalize(text){
    return String(text)
        .toLowerCase()
        .trim()
        .replace(/ي/g,"ی")
        .replace(/ى/g,"ی")
        .replace(/ك/g,"ک")
        .replace(/\u200c/g," ")
        .replace(/[؟?!.,،؛:()\[\]{}"'«»]/g," ")
        .replace(/\s+/g," ")
        .trim();
}


/* =========================================================
   بارگذاری پایگاه دانش
========================================================= */

async function loadKnowledge(){

    try{
        const res = await fetch(KNOWLEDGE_URL);

        if(!res.ok) throw new Error("HTTP " + res.status);

        const data = await res.json();

        /* پشتیبانی از هر دو ساختار ممکن */
        if(Array.isArray(data)){
            knowledgeBase = data;
        } else if(Array.isArray(data.questions)){
            knowledgeBase = data.questions;
        } else {
            throw new Error("ساختار JSON ناشناخته است");
        }

        /* پشتیبانی از کلیدهای q/a یا question/answer */
        knowledgeBase = knowledgeBase.map(item => ({
            q: item.q || item.question || item.Q || "",
            a: item.a || item.answer || item.A || "",
            category: item.category || item.cat || ""
        })).filter(x => x.q && x.a);

        if(knowledgeBase.length === 0){
            throw new Error("هیچ سوالی یافت نشد");
        }

        dbReady = true;
        sendBtn.disabled = false;

        statusText.textContent =
            knowledgeBase.length.toLocaleString("fa-IR") + " سوال بارگذاری شد";

        console.log("Raptor AI:", knowledgeBase.length, "سوال");

    } catch(err){
        statusText.textContent = "خطا در بارگذاری";
        console.error("Load error:", err);
    }
}


/* =========================================================
   جستجوی پاسخ (شباهت کلیدواژه‌ای)
========================================================= */

function findAnswer(question){

    const q = normalize(question);
    if(!q) return null;

    const qWords = q.split(" ");

    let best = null;
    let bestScore = 0;

    for(const item of knowledgeBase){

        const key = normalize(item.q);
        const keyWords = key.split(" ");

        /* تطبیق دقیق */
        if(q === key){
            return item.a;
        }

        /* شمارش کلمات مشترک */
        let common = 0;
        for(const w of qWords){
            if(w.length >= 2 && keyWords.includes(w)){
                common++;
            }
        }

        if(common === 0) continue;

        /* محاسبه شباهت (Jaccard ساده) */
        const union = new Set([...qWords, ...keyWords]).size;
        const score = common / union;

        if(score > bestScore){
            bestScore = score;
            best = item.a;
        }
    }

    /* آستانه پیشنهادی 0.45 از خود فایل */
    if(bestScore >= 0.30){
        return best;
    }

    return null;
}


/* =========================================================
   افزودن پیام به چت
========================================================= */

function addMessage(text, type){
    const el = document.createElement("div");
    el.className = "msg " + type;
    el.textContent = text;
    chatBody.appendChild(el);
    chatBody.scrollTop = chatBody.scrollHeight;
    return el;
}


/* =========================================================
   ارسال پیام
========================================================= */

async function sendMessage(){

    const text = userInput.value.trim();
    if(!text || !dbReady) return;

    addMessage(text, "user");
    userInput.value = "";
    userInput.style.height = "auto";

    const loading = addMessage("در حال پردازش...", "bot");

    await new Promise(r => setTimeout(r, 200));

    const answer = findAnswer(text);

    loading.remove();

    if(answer){
        addMessage(answer, "bot");
    } else {
        addMessage(
            "متأسفم، پاسخی برای این سوال در پایگاه دانش Raptor AI پیدا نکردم.",
            "bot"
        );
    }
}


/* =========================================================
   رویدادها
========================================================= */

sendBtn.addEventListener("click", sendMessage);

userInput.addEventListener("keydown", e => {
    if(e.key === "Enter" && !e.shiftKey){
        e.preventDefault();
        sendMessage();
    }
});

userInput.addEventListener("input", function(){
    this.style.height = "auto";
    this.style.height = Math.min(this.scrollHeight, 90) + "px";
});

chatToggle.addEventListener("click", () => {
    chatPanel.classList.toggle("open");
});


/* =========================================================
   شروع
========================================================= */

loadKnowledge();
</script>

</body>
</html>
